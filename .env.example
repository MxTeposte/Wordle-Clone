# Copia este archivo a .env.local para desarrollo. En Vercel, define las variables en
# Settings → Environment Variables (valores distintos para Production y Preview).

# Semilla secreta que ordena las soluciones diarias. Cadena aleatoria larga.
WORD_SEED=

# Clave para cifrar los tokens del modo práctica. Genera una con: openssl rand -base64 32
GAME_SECRET=

# Fecha del reto #1 (YYYY-MM-DD). No es secreta.
START_DATE=2026-09-15
